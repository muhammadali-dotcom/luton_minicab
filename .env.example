# Search indexing. Production on Vercel (VERCEL_ENV=production) is indexable automatically;
# previews never are. Set true only to force indexing elsewhere. Rebuild after changing:
# metadata, robots.txt and the sitemap are generated during the build.
SITE_INDEXABLE=false

# Google Search Console ownership code: the content="..." value of the HTML tag method.
GOOGLE_SITE_VERIFICATION=
